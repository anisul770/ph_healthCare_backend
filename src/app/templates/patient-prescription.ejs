<%
  const emailBrand = typeof brandName === 'string' && brandName.trim() ? brandName.trim() : 'PH Healthcare';
  const recipientName = typeof patientName === 'string' && patientName.trim() ? patientName.trim() : null;
  const doctorSpecialization = typeof specialization === 'string' && specialization.trim() ? specialization.trim() : null;
  const totalMedicines = typeof medicineCount === 'number' && Number.isFinite(medicineCount) ? medicineCount : null;
  const downloadUrl = typeof prescriptionUrl === 'string' && prescriptionUrl.trim() ? prescriptionUrl.trim() : null;
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Your prescription is ready | <%= emailBrand %></title>
    <style>
      @media only screen and (max-width: 600px) {
        .outer-padding { padding: 24px 12px !important; }
        .content-padding { padding: 32px 24px !important; }
        .header-padding { padding: 24px !important; }
        .email-title { font-size: 26px !important; line-height: 34px !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; width: 100%; background-color: #f1f5f9; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    <div style="display: none; font-size: 1px; color: #f1f5f9; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; mso-hide: all;">
      Dr. <%= doctorName %> has shared your prescription. It's attached to this email as a PDF.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f1f5f9" style="width: 100%; border-collapse: collapse; background-color: #f1f5f9; font-family: Arial, Helvetica, sans-serif;">
      <tr>
        <td class="outer-padding" align="center" style="padding: 48px 20px;">
          <!--[if mso]>
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td>
          <![endif]-->
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width: 100%; max-width: 600px; border: 1px solid #e2e8f0; border-spacing: 0; border-radius: 16px; background-color: #ffffff;">
            <tr>
              <td class="header-padding" bgcolor="#0f766e" style="padding: 28px 40px; background-color: #0f766e; border-radius: 16px 16px 0 0;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="font-size: 22px; line-height: 30px; font-weight: 700; color: #ffffff;">
                      <%= emailBrand %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-top: 4px; font-size: 12px; line-height: 18px; letter-spacing: 1px; color: #ccfbf1;">
                      MEDICAL PRESCRIPTION
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="content-padding" style="padding: 40px;">
                <h1 class="email-title" style="margin: 0 0 20px; font-size: 30px; line-height: 38px; font-weight: 700; letter-spacing: -0.5px; color: #0f172a;">
                  Your prescription is ready
                </h1>
                <p style="margin: 0 0 12px; font-size: 16px; line-height: 26px; color: #334155;">
                  <% if (recipientName) { %>Hi <%= recipientName %>,<% } else { %>Hello,<% } %>
                </p>
                <p style="margin: 0 0 28px; font-size: 16px; line-height: 26px; color: #475569;">
                  Following your consultation, Dr. <%= doctorName %> has written your prescription. You'll find it attached to this email as a PDF.
                </p>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; border: 1px solid #e2e8f0; border-collapse: separate; border-spacing: 0; border-radius: 12px;">
                  <tr>
                    <td style="padding: 14px 20px; border-bottom: 1px solid #e2e8f0; font-size: 14px; line-height: 22px; color: #64748b;">Doctor</td>
                    <td align="right" style="padding: 14px 20px; border-bottom: 1px solid #e2e8f0; font-size: 14px; line-height: 22px; font-weight: 700; color: #0f172a;">
                      Dr. <%= doctorName %>
                      <% if (doctorSpecialization) { %><br /><span style="font-weight: 400; color: #64748b;"><%= doctorSpecialization %></span><% } %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 14px 20px; <% if (totalMedicines !== null) { %>border-bottom: 1px solid #e2e8f0; <% } %>font-size: 14px; line-height: 22px; color: #64748b;">Date</td>
                    <td align="right" style="padding: 14px 20px; <% if (totalMedicines !== null) { %>border-bottom: 1px solid #e2e8f0; <% } %>font-size: 14px; line-height: 22px; font-weight: 700; color: #0f172a;"><%= prescriptionDate %></td>
                  </tr>
                  <% if (totalMedicines !== null) { %>
                  <tr>
                    <td style="padding: 14px 20px; font-size: 14px; line-height: 22px; color: #64748b;">Medicines prescribed</td>
                    <td align="right" style="padding: 14px 20px; font-size: 14px; line-height: 22px; font-weight: 700; color: #0f172a;"><%= totalMedicines %></td>
                  </tr>
                  <% } %>
                </table>

                <% if (downloadUrl) { %>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 28px auto 0;">
                  <tr>
                    <td align="center" bgcolor="#0f766e" style="border-radius: 10px; background-color: #0f766e;">
                      <a href="<%= downloadUrl %>" target="_blank" style="display: inline-block; padding: 14px 32px; font-size: 15px; line-height: 20px; font-weight: 700; color: #ffffff; text-decoration: none; border-radius: 10px;">
                        Download prescription
                      </a>
                    </td>
                  </tr>
                </table>
                <p style="margin: 12px 0 0; text-align: center; font-size: 13px; line-height: 21px; color: #64748b;">
                  You can also find it any time in your dashboard under My Appointments.
                </p>
                <% } %>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin-top: 28px; border: 1px solid #fde68a; border-spacing: 0; border-radius: 12px; background-color: #fffbeb;">
                  <tr>
                    <td style="padding: 18px 22px; font-size: 14px; line-height: 23px; color: #78350f;">
                      <strong style="color: #92400e;">Take your medicines as prescribed</strong><br />
                      Follow the dosage and duration exactly as written. If you notice side effects or your symptoms get worse, contact your doctor or seek medical care right away.
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin-top: 28px; border-top: 1px solid #e2e8f0;">
                  <tr>
                    <td style="padding-top: 24px; font-size: 14px; line-height: 23px; color: #64748b;">
                      <strong style="color: #334155;">Questions about your prescription?</strong><br />
                      Simply reply to this email and our team will help you get in touch with your doctor.
                    </td>
                  </tr>
                </table>

                <p style="margin: 28px 0 0; font-size: 14px; line-height: 23px; color: #334155;">
                  Get well soon,<br />
                  <strong>The <%= emailBrand %> Team</strong>
                </p>
              </td>
            </tr>
          </table>
          <!--[if mso]></td></tr></table><![endif]-->

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px;">
            <tr>
              <td align="center" style="padding: 24px 12px 0; font-size: 12px; line-height: 20px; color: #64748b;">
                This email contains private medical information intended only for <%= recipientName || 'the recipient' %>.<br />
                &copy; <%= new Date().getFullYear() %> <%= emailBrand %>. All rights reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
